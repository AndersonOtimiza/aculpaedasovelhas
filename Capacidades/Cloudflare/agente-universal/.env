# ==========================
# Servico
# ==========================
AGENT_PORT=8090
LOG_LEVEL=INFO
DRY_RUN=true
ALLOWLIST_BYPASS=false

# Pasta do host montada no container para execucao de CLIs e acesso local
# Use caminho relativo ao docker-compose (".." monta o repo atual; ajuste se preferir isolamento)
WORKSPACE_PATH=..

# ==========================
# LLM / Orquestracao de linguagem natural
# ==========================
# Provedores: ollama | openai | azure_openai
LLM_PROVIDER=ollama
MODEL=llama3.1:instruct
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

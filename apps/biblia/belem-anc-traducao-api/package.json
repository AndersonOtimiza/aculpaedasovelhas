{
  "name": "belem-anc-traducao-api",
  "version": "1.0.0",
  "description": "API da Nova Tradução Bíblica Literal Rígida Belem AnC - Textos originais em Hebraico, Aramaico e Grego",
  "author": "Belem, Anderson Costa",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "etl:oshb": "ts-node src/etl/import-oshb.ts",
    "etl:sblgnt": "ts-node src/etl/import-sblgnt.ts",
    "etl:aramaic": "ts-node src/etl/import-bhsa-arm.ts",
    "etl:all": "npm run etl:oshb && npm run etl:sblgnt && npm run etl:aramaic"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.18",
    "@types/node": "^20.8.0",
    "@types/pg": "^8.10.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}

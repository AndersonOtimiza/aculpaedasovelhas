# exeg.ai - Advanced Exegesis Machine
# Copy this file to .env and configure

# Server
API_PORT=8000
DEBUG=true

# Bible API
BIBLIA_API_URL=http://localhost:3001
BIBLIA_API_TIMEOUT=30

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# FAISS
FAISS_INDEX_PATH=./indexes/faiss/bible_index.faiss
USE_FAISS_GPU=true

# Embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=./models/sentence-transformers

# ===========================================
# BILLING SYSTEM
# ===========================================

# JWT Authentication
# IMPORTANT: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# SQLite for development, PostgreSQL for production
DATABASE_URL=sqlite:///./database/exeg.db
# DATABASE_URL=postgresql://user:password@localhost:5432/exeg_db

# Stripe (for payments)
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_STARTER=price_starter_xxx
STRIPE_PRICE_PRO=price_pro_xxx

# Encryption (for BYOK API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ===========================================
# PIX - OTIMIZA PAGAMENTOS
# ===========================================
# OtimizaPro - WorkTech brasileira (Cubo Itaú - Vila Olímpia, SP)
# WhatsApp oficial: +55 21 99448-7472

# WhatsApp da ANA (IA de validação de comprovantes)
OTIMIZA_WHATSAPP=+5521994487472

# Webhook secret para validar chamadas da ANA
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OTIMIZA_WEBHOOK_SECRET=

# Chave PIX (email ou CNPJ da Otimiza)
OTIMIZA_PIX_KEY=pix@otimizapagamentos.com.br

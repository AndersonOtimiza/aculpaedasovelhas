# exeg.ai - Advanced Exegesis Machine
# Generated for development

# Server
API_PORT=8002
DEBUG=true

# Bible API
BIBLIA_API_URL=http://localhost:3001
BIBLIA_API_TIMEOUT=30

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# FAISS
FAISS_INDEX_PATH=./indexes/faiss/bible_index.faiss
USE_FAISS_GPU=true

# Embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=./models/sentence-transformers

# ===========================================
# BILLING SYSTEM
# ===========================================

# JWT Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite:///./database/exeg.db

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs
STRIPE_PRICE_STARTER=price_starter_xxx
STRIPE_PRICE_PRO=price_pro_xxx

# Encryption (for BYOK API keys)
ENCRYPTION_KEY=

# ===========================================
# PIX - OTIMIZA PAGAMENTOS
# ===========================================
OTIMIZA_WHATSAPP=+5521994487472
OTIMIZA_WEBHOOK_SECRET=
OTIMIZA_PIX_KEY=pix@otimizapagamentos.com.br
